string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${source}/CMakeLists.txt" "${project}")
function(configure_case name build package_mode tainted expected_error)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${test_root}/${build}"
    "-DOBS_PLUGIN_PACKAGE_BUILD:BOOL=${package_mode}" "-DEXPECT_TAINTED:BOOL=${tainted}"
    "-DQt6_DIR=${cache}/${qt6_prefix}/lib/cmake/Qt6" "-Dlibobs_DIR=${cache}/cmake"
    "-Dobs-frontend-api_DIR=${cache}/cmake" "-DCMAKE_PREFIX_PATH=${cache}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected_error)
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected_error}")
      message(FATAL_ERROR "${name}: expected rejection (${expected_error}): ${output}${error}")
    endif()
  elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "${name}: ${output}${error}")
  endif()
  message(STATUS "PASS: ${name}")
endfunction()
configure_case("initial developer extraction" developer OFF OFF "")
foreach(payload "${prebuilt_prefix}/${prebuilt_payload}" "${qt6_prefix}/${qt6_payload}"
    "${obs-studio_prefix}/${obs-studio_payload}" "${obs-studio_prefix}/build_x64/stale.obj" "lib/obs.lib")
  file(WRITE "${cache}/${payload}" "modified-after-extraction")
endforeach()
# Valid VERSION/marker/archive hashes do not attest extracted/source/object/lib bytes.
configure_case("reproduce trusted developer reuse of modified payloads" developer OFF ON "")
configure_case("package ignores modified source/prebuilt/Qt/object/install" package-one ON OFF "")
# Poison a previous package too; another new package must still start from archives.
file(WRITE "${test_root}/package-one/.deps/${obs-studio_prefix}/${obs-studio_payload}" "modified-after-extraction")
configure_case("next package ignores previous package extraction" package-two ON OFF "")
foreach(kind prebuilt qt6 obs-studio)
  file(COPY_FILE "${${kind}_archive}" "${test_root}/archive-backup.zip")
  file(WRITE "${${kind}_archive}" "corrupt cached archive")
  configure_case("${kind} corrupt shared archive rejected" "corrupt-${kind}" ON OFF "Dependency SHA256 mismatch")
  file(COPY_FILE "${test_root}/archive-backup.zip" "${${kind}_archive}")
endforeach()
file(READ "${cache}/lib/obs.lib" original_library)
if(NOT original_library STREQUAL "modified-after-extraction")
  message(FATAL_ERROR "Package mutated the developer dependency installation")
endif()
message(STATUS "Package dependency isolation passed: 7 scenarios")
