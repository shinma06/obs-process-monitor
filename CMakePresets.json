{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 / OBS 32.2.2",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "version=14.51,host=x64",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "PLUGIN_BUILD_NUMBER": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
